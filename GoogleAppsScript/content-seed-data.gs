function seedContentSheetsFromWebsiteData() {
  const spreadsheet = SpreadsheetApp.openById(CONTENT_SPREADSHEET_ID);
  const summary = {};

  Object.keys(CONTENT_SEED_DATA).forEach(function (type) {
    const config = CONTENT_SHEETS[type];
    if (!config) return;

    const sheet = getOrCreateContentSheet(spreadsheet, config);
    ensureContentHeaders(sheet, config);

    const headers = getContentHeaders(config);
    const headerMap = buildContentHeaderMap(sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0]);
    const idColumnIndex = headerMap[normalizeContentHeader("ID")];
    const existingIds = buildExistingSeedIds(sheet, idColumnIndex);
    const rowsToAppend = [];

    CONTENT_SEED_DATA[type].forEach(function (item, index) {
      const id = String(item.id || "").trim();
      if (id && existingIds[id]) return;
      rowsToAppend.push(buildSeedContentRow(item, config, index + 1));
      if (id) existingIds[id] = true;
    });

    if (rowsToAppend.length) {
      sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, headers.length).setValues(rowsToAppend);
      applyContentSheetFormatting(sheet, headers.length);
    }

    summary[type] = {
      sheetName: config.sheetName,
      inserted: rowsToAppend.length,
      totalRows: Math.max(sheet.getLastRow() - 1, 0)
    };
  });

  return summary;
}

function buildExistingSeedIds(sheet, idColumnIndex) {
  const ids = {};
  if (idColumnIndex === undefined || sheet.getLastRow() < 2) return ids;

  const idValues = sheet.getRange(2, idColumnIndex + 1, sheet.getLastRow() - 1, 1).getValues();
  idValues.forEach(function (row) {
    const id = String(row[0] || "").trim();
    if (id) ids[id] = true;
  });
  return ids;
}

function buildSeedContentRow(item, config, order) {
  const values = config.fields.map(function (fieldConfig) {
    const field = fieldConfig[1];
    return normalizeSeedContentValue(item[field]);
  });
  return ["yes", order].concat(values);
}

function normalizeSeedContentValue(value) {
  if (Array.isArray(value)) return value.join(", ");
  return value === undefined || value === null ? "" : String(value);
}
